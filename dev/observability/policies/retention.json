{
  "policy": {
    "description": "Local operational telemetry: delete indexes after 7 days; not business audit",
    "default_state": "retain",
    "states": [
      {
        "name": "retain",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "7d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          "reconflow-logs-*",
          "ss4o_metrics-otel-reconflow-v2-*",
          "otel-v1-apm-service-map*"
        ],
        "priority": 200
      }
    ]
  }
}
